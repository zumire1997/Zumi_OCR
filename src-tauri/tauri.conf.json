{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zumi OCR",
  "version": "0.17.1",
  "identifier": "com.zumiscan.zumiocr",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zumi OCR",
        "url": "Zumi_OCR.html",
        "width": 1320,
        "height": 800,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Spanish",
          "English"
        ],
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "PEGAR_AQUI_TU_CLAVE_PUBLICA",
      "endpoints": [
        "https://github.com/zumire1997/Zumi_OCR_Tauri/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
